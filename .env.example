# Copy to .env to override defaults.
CLICKHOUSE_USER=mf
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_API_PASSWORD=change-me-too
MF_API_PORT=18080
MF_API_PUBLIC_URL=http://localhost:18080
REDIS_MAXMEMORY=512mb
# comma-separated origins for the web UI, or *
MF_API_CORS_ORIGINS=*
# web UI
MF_WEB_PORT=13000
SITE_URL=http://localhost:13000
MF_CONCURRENCY=8
# sec min hour day month weekday, `;`-separated, evaluated in MF_TIMEZONE
MF_SCHEDULE=0 30 23 * * *;0 0 7 * * *
MF_TIMEZONE=Asia/Kolkata
RUST_LOG=info
