# Copy to .env to override defaults.
CLICKHOUSE_USER=mf
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_API_PASSWORD=change-me-too
MF_API_PORT=18080
MF_API_PUBLIC_URL=http://localhost:18080
REDIS_MAXMEMORY=512mb
# comma-separated origins for the web UI, or *
MF_API_CORS_ORIGINS=*
# web UI
MF_WEB_PORT=13000
# interface the UI listens on; 0.0.0.0 to reach it from other hosts
MF_WEB_BIND=127.0.0.1
# edge rate limits: client address header, trusted only from this proxy address/CIDR
MF_TRUSTED_PROXY=127.0.0.1
MF_REAL_IP_HEADER=X-Forwarded-For
SITE_URL=http://localhost:13000
MF_CONCURRENCY=8
# sec min hour day month weekday, `;`-separated, evaluated in MF_TIMEZONE
MF_SCHEDULE=0 0 */4 * * *
MF_TIMEZONE=Asia/Kolkata
# sync as soon as the scheduler starts (false: wait for the first MF_SCHEDULE slot)
MF_RUN_ON_START=true
RUST_LOG=info
