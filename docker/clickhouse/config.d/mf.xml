<clickhouse>
    <!-- Dates are stored as Date (no zone); keep the server on UTC so DateTime columns are unambiguous. -->
    <timezone>UTC</timezone>
    <logger>
        <level>warning</level>
    </logger>
    <!-- Leave headroom for the OS and the ingester on small hosts. -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

    <!-- Small-host profile: the whole stack should idle well under 1 GB on a 1-4 core VM.
         Follows https://clickhouse.com/docs/operations/tips (RAM) and
         https://kb.altinity.com/altinity-kb-setup-and-maintenance/configure_clickhouse_for_low_mem_envs/ -->

    <!-- Self-monitoring logs. By default ClickHouse snapshots metrics every second and keeps
         profiler traces, which cost more disk than the data itself and most of the idle CPU. Only
         the query log stays, for a week. -->
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
    <asynchronous_metrics_update_period_s>30</asynchronous_metrics_update_period_s>

    <!-- Caches: the working set is ~1.5 GB on disk and the OS page cache serves it well. -->
    <mark_cache_size>536870912</mark_cache_size>                   <!-- 512 MB; the docs' floor -->
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>16777216</uncompressed_cache_size>
    <primary_index_cache_size>134217728</primary_index_cache_size>
    <vector_similarity_index_cache_size>16777216</vector_similarity_index_cache_size>
    <text_index_header_cache_size>16777216</text_index_header_cache_size>
    <text_index_postings_cache_size>16777216</text_index_postings_cache_size>
    <compiled_expression_cache_size>67108864</compiled_expression_cache_size>

    <!-- Background threads: one writer (the pipeline), no replication, Kafka or distributed tables. -->
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    <background_common_pool_size>2</background_common_pool_size>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_move_pool_size>1</background_move_pool_size>
    <background_fetches_pool_size>1</background_fetches_pool_size>
    <background_buffer_flush_schedule_pool_size>1</background_buffer_flush_schedule_pool_size>
    <background_distributed_schedule_pool_size>1</background_distributed_schedule_pool_size>
    <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
    <max_concurrent_queries>32</max_concurrent_queries>
    <merge_tree>
        <!-- must fit within background_pool_size x concurrency ratio (8), or the server won't start -->
        <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>
</clickhouse>
